{
  "manifestVersion": 5,
  "id": "com.quickcaption.premiere.qa",
  "name": "Quick Caption QA",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [{ "type": "panel", "id": "quickCaption", "label": { "default": "Quick Caption QA" },
    "minimumSize": { "width": 300, "height": 420 }, "preferredDockedSize": { "width": 360, "height": 650 },
    "preferredFloatingSize": { "width": 380, "height": 700 } },
    { "type": "command", "id": "captionSelection", "label": { "default": "קבלת כתוביות לקטעים שנבחרו" } }],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["https://quick-caption.com"] },
    "ipc": { "enablePluginCommunication": true },
    "launchProcess": { "schemes": ["https"], "extensions": [] }
  }
}

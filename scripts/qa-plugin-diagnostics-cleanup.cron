# QA only: remove the two fixed diagnostic files if QA has stopped/rolled back.
# Active QA prunes individual records every 15 minutes; this is an idle fallback.
17 * * * * root if [ -d /home/quick-caption-qa/shared/plugin-diagnostics ]; then /usr/bin/find /home/quick-caption-qa/shared/plugin-diagnostics -maxdepth 1 -type f \( -name reports.json -o -name reports.json.tmp \) -mmin +10095 -delete; fi
